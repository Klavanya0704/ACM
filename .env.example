# ========================================================
# SITE ACM STUDENT CHAPTER — ENVIRONMENT CONFIGURATION
# Sasi Institute of Technology & Engineering
# ========================================================

# --------------------------------------------------------
# FRONTEND PUBLIC ENVIRONMENT VARIABLES
# Safe to expose in client-side production bundles
# --------------------------------------------------------

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Anonymous/Publishable API Key (Safe for frontend public access)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Custom API Base URL (if connecting to a separate backend proxy/service)
VITE_API_BASE_URL=http://localhost:5000

# --------------------------------------------------------
# BACKEND / SERVER-SIDE PRIVATE VARIABLES
# NEVER expose in client-side code or public repositories!
# --------------------------------------------------------

# Supabase Service Role Key (Bypasses RLS - Server Side ONLY)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Port (for custom backend web services)
# PORT=5000

# ========================================================
# SITE ACM STUDENT CHAPTER — BACKEND ENVIRONMENT TEMPLATE
# ========================================================

# Server Port (Local Default: 5000)
PORT=5000

# Primary Development Frontend Allowed Origin for CORS
FRONTEND_URL=http://localhost:3000

# Supabase Server Credentials (Service Role Key MUST remain private)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Admin Secret Key for protected backend routes
ADMIN_SECRET_KEY=site-acm-admin-secret
